<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#11100d">
<title>Meltech — Invoices & Quotations</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#171612;--muted:#89877f;--gold:#eaa91f;--gold2:#ffc94d;--line:#e9e6df;--paper:#fff;--bg:#f4f3f0;--green:#21865c;--shadow:0 18px 54px #27231912}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px 'DM Sans',sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{min-height:100vh}.topbar{height:70px;background:#13120f;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 5.2%;border-bottom:1px solid #29271f}.brand{display:flex;align-items:center;gap:11px;font:800 18px Manrope,sans-serif;letter-spacing:.5px}.brand-mark{width:34px;height:34px;border:1px solid #594419;border-radius:10px;display:grid;place-items:center;color:var(--gold);font-size:21px}.brand small{display:block;font:500 9px 'DM Sans';color:#aaa69a;letter-spacing:1.6px;margin-top:2px}.topright{display:flex;align-items:center;gap:20px;color:#aaa69a;font-size:12px}.avatar{width:32px;height:32px;border-radius:50%;background:#30291a;color:#ffc94d;display:grid;place-items:center;font-weight:700}.layout{display:grid;grid-template-columns:218px 1fr;max-width:1500px;margin:auto;min-height:calc(100vh - 70px)}aside{padding:30px 15px;border-right:1px solid #e8e5df}.navlabel{padding:0 13px 11px;color:#a09d94;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.nav{display:flex;align-items:center;gap:12px;padding:11px 13px;margin:2px 0;border-radius:8px;color:#69675f;font-size:13px;text-decoration:none}.nav.active{background:#fff6e3;color:#8b5d00;font-weight:700}.nav .ic{width:18px;text-align:center;font-size:15px}.sidecard{margin:36px 5px 0;padding:16px;border-radius:10px;background:#191813;color:white}.sidecard .spark{color:var(--gold);font-size:17px}.sidecard strong{display:block;margin:8px 0 5px;font:700 12px Manrope}.sidecard p{margin:0;color:#aaa79c;font-size:11px;line-height:1.6}.main{padding:36px clamp(22px,4vw,60px) 60px;min-width:0}.heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:27px}.eyebrow{color:#9c7a31;font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.heading h1{font:800 27px Manrope;margin:6px 0}.heading p{margin:0;color:#817f77;font-size:13px}.actions{display:flex;gap:9px;align-items:center}.btn{border:1px solid var(--line);border-radius:8px;background:#fff;padding:10px 14px;font-weight:600;font-size:12px;color:#34322d;box-shadow:0 1px 2px #00000006}.btn:hover{border-color:#d1a43e}.btn.primary{background:#181712;border-color:#181712;color:#fff}.btn.gold{background:var(--gold);border-color:var(--gold);color:#211b0d}.content{display:grid;grid-template-columns:minmax(300px,.83fr) minmax(470px,1.17fr);gap:22px;align-items:start}.panel{background:white;border:1px solid #e9e6df;border-radius:12px;box-shadow:var(--shadow)}.formpanel{padding:22px}.paneltitle{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.paneltitle h2{font:700 14px Manrope;margin:0}.step{color:#a49f91;font-size:11px}.type-switch{display:flex;background:#f3f2ef;padding:4px;border-radius:8px;margin-bottom:20px}.type-switch button{border:0;background:transparent;flex:1;padding:9px;color:#79766d;border-radius:6px;font-weight:600;font-size:12px}.type-switch button.selected{background:white;color:#171612;box-shadow:0 1px 4px #00000012}.section-label{font-size:10px;text-transform:uppercase;letter-spacing:1.1px;color:#9a968b;font-weight:700;margin:21px 0 11px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{min-width:0}.field.wide{grid-column:1/-1}.field label{display:block;font-size:10px;color:#77746c;font-weight:600;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid #e9e6df;border-radius:7px;padding:9px 10px;color:#27251f;background:white;outline:none;font-size:12px}.field input:focus,.field textarea:focus{border-color:#d4a73f;box-shadow:0 0 0 3px #f8ebcb}.field textarea{resize:vertical;min-height:62px}.items-head{display:grid;grid-template-columns:minmax(90px,1fr) 52px 75px 85px 25px;gap:6px;color:#99958b;font-size:9px;text-transform:uppercase;letter-spacing:.5px;padding:0 0 6px}.itemrow{display:grid;grid-template-columns:minmax(90px,1fr) 52px 75px 85px 25px;gap:6px;margin-bottom:7px;align-items:center}.itemrow input{width:100%;min-width:0;border:1px solid #e9e6df;border-radius:6px;padding:8px 7px;font-size:11px}.itemrow .desc{font-size:11px}.remove{border:0;background:none;color:#b0aca3;font-size:16px}.addrow{background:none;border:0;color:#9a6b05;padding:7px 0;font-size:11px;font-weight:700}.previewpanel{overflow:hidden}.preview-toolbar{display:flex;justify-content:space-between;align-items:center;padding:14px 17px;border-bottom:1px solid #eeece7;color:#77746c;font-size:11px}.live{color:var(--green);font-weight:700}.paper{margin:18px auto 22px;width:min(calc(100% - 36px),660px);background:white;border:1px solid #eee9dd;box-shadow:0 6px 20px #16130d12;min-height:760px;position:relative;overflow:hidden;font-family:'DM Sans',sans-serif}.paper:after{content:'✳';position:absolute;z-index:0;color:#f5ecda;font-size:250px;opacity:.32;right:-38px;top:340px;transform:rotate(-20deg);pointer-events:none}.dochead{height:auto;padding:0;line-height:0;background:#11100e;border-bottom:4px solid var(--gold)}.dochead img{width:100%;height:auto;display:block}.docbody{padding:12px 30px 18px;position:relative;z-index:1}.doctitle{text-align:center;font:800 34px Manrope;letter-spacing:2px;margin:0 0 12px}.details{display:grid;grid-template-columns:1fr 1fr;border:1px solid #dda222;border-radius:8px;margin-bottom:13px;overflow:hidden}.details-col{padding:11px 13px}.details-col+ .details-col{border-left:1px solid #dda222}.detail{display:grid;grid-template-columns:88px 1fr;gap:7px;margin:7px 0;font-size:10px;line-height:1.45}.detail b{font-weight:700}.table{width:100%;border-collapse:collapse;font-size:10px}.table th{background:#11100e;color:#f2ae23;padding:9px 7px;text-align:left;font-size:9px}.table th:first-child{border-radius:5px 0 0 0}.table th:last-child{border-radius:0 5px 0 0;text-align:right}.table td{padding:10px 7px;border:1px solid #e0a522;text-align:left;vertical-align:top}.table td:nth-child(1),.table td:nth-child(3),.table td:nth-child(4){text-align:center}.table td:last-child{text-align:right}.table th:nth-child(3),.table th:nth-child(4){text-align:center}.totals{margin-left:auto;width:52%;font-size:10px}.totalrow{display:grid;grid-template-columns:1fr 42px 75px;padding:7px 9px;border:1px solid #e0a522;border-top:0;font-weight:700}.totalrow:last-child{background:#e6a20e;border-radius:0 0 6px 6px}.totalrow span:last-child{text-align:right}.notes{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:25px}.note h3{font:800 10px Manrope;border-bottom:1px solid #e4ae33;padding-bottom:7px;margin:0 0 8px}.note p{font-size:9px;line-height:1.6;margin:0;color:#37352f}.terms{padding-left:15px}.terms li{font-size:9px;line-height:1.55;padding-left:3px}.signature-img{display:block;width:98px;height:auto;margin:5px auto 0;image-rendering:auto;opacity:.96}.signature{display:flex;justify-content:space-between;border-top:1px solid #e2aa30;margin-top:17px;padding-top:10px;text-align:center;font-size:9px}.signature strong{display:block;font-size:10px;letter-spacing:.5px}.docfoot{background:transparent;padding:0;display:block;line-height:0}.docfoot img{display:block;width:100%;height:auto}.history{margin-top:26px}.history h2{font:700 14px Manrope;margin:0 0 12px}.history-list{display:grid;gap:8px}.history-item{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid #eae7e0;border-radius:9px;padding:11px 14px;font-size:11px}.hist-left{display:flex;align-items:center;gap:12px}.docbadge{background:#fff5dc;color:#8c620d;border-radius:6px;padding:7px;font-size:10px;font-weight:700}.hist-title{font-weight:700}.hist-sub{color:#96928a;font-size:10px;margin-top:3px}.hist-total{font-weight:700}.history-actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.history-actions .btn{font-size:10px;padding:7px 9px}.acct-tools{display:flex;align-items:end;gap:8px}.acct-tools label{font-size:10px;color:#78756d;font-weight:600}.acct-tools select{display:block;margin-top:4px;padding:8px;border:1px solid var(--line);border-radius:7px;background:white;font-size:11px}.report-note{font-size:10px;color:#88847a;margin:0 0 10px}.accounting{margin-top:30px}.account-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:13px}.account-heading h2{font:700 16px Manrope;margin:0 0 5px}.account-heading p{font-size:11px;color:#858178;margin:0}.account-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:13px}.account-stat{background:#fff;border:1px solid #eae7e0;border-radius:9px;padding:13px}.account-stat small{display:block;text-transform:uppercase;letter-spacing:.7px;color:#8a867d;font-size:9px;font-weight:700}.account-stat strong{display:block;margin-top:6px;font:700 16px Manrope}.account-list{display:grid;gap:9px}.account-doc{background:white;border:1px solid #eae7e0;border-radius:9px;overflow:hidden}.account-doc summary{list-style:none;display:grid;grid-template-columns:minmax(140px,1.5fr) repeat(3,minmax(95px,1fr));gap:10px;align-items:center;padding:12px 14px;cursor:pointer}.account-doc summary::-webkit-details-marker{display:none}.account-doc[open] summary{border-bottom:1px solid #eee}.acct-name{font-weight:700;font-size:11px}.acct-name small{display:block;color:#8f8b82;font-weight:400;margin-top:3px}.acct-val{font-size:10px;color:#777}.acct-val b{display:block;color:#26241f;font-size:11px;margin-top:3px}.acct-groups{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px}.acct-group{border:1px solid #eee;border-radius:7px;padding:10px}.acct-group h3{font:700 11px Manrope;margin:0 0 7px}.acct-table{width:100%;border-collapse:collapse;font-size:10px}.acct-table th,.acct-table td{text-align:left;padding:6px 4px;border-bottom:1px solid #f0eee9}.acct-table td:nth-child(n+2),.acct-table th:nth-child(n+2){text-align:right}.acct-none{padding:16px;background:white;border:1px dashed #ddd8ca;border-radius:8px;color:#89867e;text-align:center;font-size:11px}.status-pill{display:inline-block;padding:4px 7px;border-radius:20px;font-size:9px;font-weight:700;margin-top:4px;background:#f0eee9;color:#777}.status-pill.paid{background:#e4f5ec;color:#187348}.status-pill.partial{background:#fff3d6;color:#8c620d}.doc-dialog{width:min(740px,94vw);max-height:90vh;border:1px solid #e5e0d5;border-radius:12px;padding:0;box-shadow:0 25px 80px #0004}.doc-dialog::backdrop{background:#15130fc2}.dialog-head{position:sticky;top:0;background:white;padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;z-index:2}.dialog-head h2{font:700 15px Manrope;margin:0}.dialog-body{padding:20px;overflow:auto}.view-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:16px}.view-cell{padding:10px;border:1px solid var(--line);border-radius:7px;font-size:12px}.view-cell small{display:block;color:#89877f;font-size:10px;margin-bottom:4px}.view-lines{width:100%;border-collapse:collapse;font-size:11px}.view-lines th,.view-lines td{padding:9px;border-bottom:1px solid var(--line);text-align:left}.view-lines th:last-child,.view-lines td:last-child{text-align:right}.view-meta{font-size:12px;line-height:1.7;color:#555;margin:14px 0}.empty{color:#928f86;background:#fff;border:1px dashed #ddd8ca;padding:16px;border-radius:8px;text-align:center;font-size:11px}.toast{position:fixed;bottom:22px;right:22px;padding:12px 16px;background:#191813;color:white;border-radius:8px;box-shadow:var(--shadow);font-size:12px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:1050px){.content{grid-template-columns:1fr}.paper{width:min(100% - 36px,740px)}.formpanel{order:1}.previewpanel{order:0}}@media(max-width:650px){.topbar{padding:0 18px}.topright span{display:none}.layout{display:block}aside{display:none}.main{padding:25px 14px}.heading{display:block}.actions{margin-top:15px}.content{display:flex;flex-direction:column}.previewpanel{width:100%;order:0}.formpanel{width:100%;order:1}.paper{width:calc(100% - 16px);margin:8px}.docbody{padding:10px 12px}.doctitle{font-size:27px}.detail{grid-template-columns:70px 1fr;font-size:8px}.details-col{padding:7px}.table{font-size:8px}.table th{font-size:7px;padding:7px 4px}.table td{padding:7px 4px}.totals{width:66%}.notes{gap:10px}.note p,.terms li{font-size:8px}.docfoot{font-size:7px;padding:10px 8px}.docfoot b{font-size:7px}.fields{gap:10px}.account-stats{grid-template-columns:1fr 1fr}.account-heading{display:block}.acct-tools{margin-top:12px;align-items:center;flex-wrap:wrap}.account-heading .eyebrow{display:block;margin-top:9px}.account-doc summary{grid-template-columns:1fr 1fr}.acct-groups{grid-template-columns:1fr}.itemrow,.items-head{grid-template-columns:minmax(75px,1fr) 40px 57px 70px 20px;gap:4px}.itemrow input{padding:7px 4px;font-size:10px}}
@media print{@page{size:A4;margin:0}body{background:white}.topbar,aside,.heading,.formpanel,.preview-toolbar,.history,.accounting{display:none!important}.layout{display:block;min-height:0}.main{padding:0}.content{display:block}.previewpanel{border:0;box-shadow:none}.paper{width:210mm;min-height:297mm;margin:0;border:0;box-shadow:none;transform:none}.dochead{height:auto;padding:0}.docbody{padding:3mm 8mm}.docfoot{position:absolute;bottom:0;width:100%}.paper:after{-webkit-print-color-adjust:exact;print-color-adjust:exact}.dochead,.table th,.totalrow:last-child,.docfoot{-webkit-print-color-adjust:exact;print-color-adjust:exact}}

/* The uploaded invoice is the stationery layer; only data fields are redrawn. */
.stationery{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;z-index:0;display:block}.paper{container-type:inline-size;position:relative;width:min(calc(100% - 36px),660px);max-width:660px;min-height:0;height:auto;aspect-ratio:1024/1535;margin:18px auto;background:#fff;border:0;box-shadow:0 6px 20px #16130d12;overflow:hidden}
.paper:after{display:none}.dochead,.docfoot{display:none!important}.docbody{position:absolute;inset:0;padding:0;z-index:1}
.doctitle{position:absolute;top:21.8%;left:0;width:100%;margin:0;font:800 7.3cqw/1 Manrope,'Arial',sans-serif;letter-spacing:.12em;text-align:center;color:#080808}
.details{position:absolute;top:28.05%;left:4.8%;width:90.4%;height:16.8%;display:block;border:0;margin:0;overflow:hidden}.details-col{display:contents}.details-col+.details-col{border:0}.details .detail{position:absolute;display:block;margin:0;padding:0;border:0;font:400 1.95cqw/1.25 'DM Sans',Arial,sans-serif;white-space:nowrap}.details .detail b{display:none}.details .detail span{display:block;white-space:nowrap}.details-col:first-child .detail:nth-child(1){left:25%;top:13%}.details-col:first-child .detail:nth-child(2){left:25%;top:43%}.details-col:last-child .detail:nth-child(1){left:75%;top:13%;font-weight:500}.details-col:last-child .detail:nth-child(2){left:75%;top:31%;}.details-col:last-child .detail:nth-child(3){left:75%;top:50%}.details-col:last-child .detail:nth-child(4){left:75%;top:68%;white-space:normal;width:43%}.details-col:last-child .detail:nth-child(4) span{white-space:pre-line}
.table{position:absolute;top:45.75%;left:4.9%;width:90.2%;height:20.65%;margin:0;display:block;border-collapse:collapse;font:400 1.55cqw/1.28 'DM Sans',Arial,sans-serif}.table thead{display:none}.table tbody{position:absolute;display:block;top:16.1%;left:0;width:100%;height:83.9%}.table tbody tr{position:absolute;left:0;width:100%;display:grid;grid-template-columns:7.5% 33% 10.4% 11.9% 20.7% 16.5%;border:0;height:18.1%;align-items:center}.table tbody tr:first-child{top:0;height:26.8%}.table tbody tr:nth-child(2){top:26.8%}.table tbody tr:nth-child(3){top:44.9%}.table tbody tr:nth-child(4){top:63%}.table tbody tr:nth-child(5){top:81.1%}.table td{display:block;min-width:0;height:auto;padding:2px 3px;border:0;text-align:center;vertical-align:middle;line-height:1.2}.table td:nth-child(2){text-align:left;padding-left:8%;white-space:normal}.table td:nth-child(5),.table td:nth-child(6){text-align:center}.table td:first-child{font-weight:700}
.totals{position:absolute;top:66.25%;left:49.5%;width:45.5%;height:5.9%;margin:0;font:700 1.75cqw/1 'DM Sans',Arial,sans-serif}.totalrow{position:absolute;left:0;width:100%;height:35%;display:grid;grid-template-columns:1fr 12% 25%;align-items:center;padding:0 2%;border:0;background:transparent}.totalrow:first-child{top:5%}.totalrow#vatRow{top:36%}.totalrow:last-child{top:66%}.totalrow span:first-child{font-weight:700}.totalrow span:nth-child(2){visibility:hidden}.totalrow span:last-child{text-align:right;white-space:nowrap}.paper:not(.has-vat) .totalrow:first-child span:first-child,.paper:not(.has-vat) .totalrow:last-child span:first-child{visibility:hidden}.paper:not(.has-vat) .totalrow:last-child{top:52%}.paper.has-vat .totalrow span:first-child{background:#fff;padding:2px 3px}.paper.has-vat .totalrow:last-child span:first-child{background:#e6a20e}.paper.has-vat .totalrow:last-child{background:#e6a20e}
.etims-preview{position:absolute;top:71.7%;left:49.5%;width:45%;height:2.3%;margin:0!important;padding:1px 3px!important;border:0!important;background:#fff;font:400 1.05cqw/1.1 'DM Sans',Arial,sans-serif;z-index:2;overflow:hidden}.etims-preview img{width:3.4cqw!important;height:3.4cqw!important;max-width:32px;max-height:32px;flex:0 0 auto}.etims-preview b{font-size:1.15cqw}
.notes{position:absolute;top:73.8%;left:4.9%;width:90.2%;height:12%;display:grid;grid-template-columns:34% 62%;gap:4%;margin:0}.note{position:relative;min-width:0}.note h3{visibility:hidden;height:27%;margin:0;padding:0;border:0}.note p,.note .terms{position:absolute;top:27%;left:0;width:95%;margin:0;padding:0;color:#171612;font:400 1.35cqw/1.45 'DM Sans',Arial,sans-serif;white-space:pre-wrap}.note .terms{left:7%;width:93%;list-style:none;counter-reset:none}.note .terms li{padding:0;margin:0;font:inherit;line-height:1.45}
.signature{position:absolute;top:86.7%;left:0;width:100%;height:7%;margin:0;padding:0;border:0;display:block;text-align:center;font-size:1.1cqw}.signature>div:first-child{display:none}.signature>div:nth-child(2){position:absolute;left:62%;top:68%;width:24%;margin:0;font-size:1.15cqw}.signature>div:nth-child(2) strong{display:block;font-size:1.3cqw;font-weight:500}.signature>div:nth-child(2)>div{display:none}.signature-img{width:98px}
@media(max-width:650px){.paper{width:calc(100% - 16px);max-width:660px;margin:8px auto}.doctitle{font-size:7.3cqw}.details .detail{font-size:1.95cqw}.table{font-size:1.55cqw}.totals{font-size:1.75cqw}.notes .note p,.notes .terms{font-size:1.35cqw}}
@media print{.paper{width:198mm;height:297mm;max-width:none;aspect-ratio:1024/1535;margin:0 auto;min-height:0;box-shadow:none;border:0;background-image:none;-webkit-print-color-adjust:exact;print-color-adjust:exact}.paper .dochead,.paper .docfoot{display:none!important}.paper .docbody{position:absolute;inset:0;padding:0}.paper .etims-preview{display:none!important}.paper.has-etims .etims-preview{display:flex!important}}
<style>.hidden{display:none!important}#authScreen label{display:block;margin:12px 0;font-size:12px}#authScreen input{display:block;width:100%;padding:9px;border:1px solid #ddd;border-radius:7px;margin-top:5px}</style></head>
<body><section id="authScreen" style="display:grid;position:fixed;z-index:20;inset:0;background:#f4f3f0;place-items:center;padding:20px"><div style="width:min(420px,100%);background:white;padding:28px;border-radius:14px"><h1>MELTECH account sign in</h1><p id="authMessage">Connect to the Vercel account API to sign in.</p><label>Email<input id="loginEmail" type="email"></label><br><label>Password<input id="loginPassword" type="password"></label><br><button id="loginBtn">Sign in</button><button id="forgotBtn">Forgot password</button><div id="resetBox" style="display:none"><label>New password (12+ characters)<input id="newPassword" type="password"></label><button id="resetBtn">Set new password</button></div><button id="localBtn" style="display:none">Local preview</button></div></section><div class="app hidden" id="appRoot"><header class="topbar"><div class="brand"><div class="brand-mark">✳</div><div>MELTECH<small>BUSINESS DESK</small></div></div><div class="topright"><span id="signedInAs">Workspace</span><button id="logoutBtn">Sign out</button><div class="avatar">MW</div></div></header><div class="layout"><aside><div class="navlabel">Workspace</div><a class="nav active" href="#"><span class="ic">▤</span>New document</a><a class="nav" href="#history"><span class="ic">◷</span>Recent documents</a><a class="nav" href="#accounting"><span class="ic">▥</span>Accounting</a><a id="adminNav" class="nav hidden" href="#adminPanel"><span class="ic">⚙</span>Accounts</a><div class="sidecard"><span class="spark">✦</span><strong>Made for your business</strong><p>Create polished invoices and quotations for every Meltech service, all in one place.</p></div></aside><main class="main"><div class="heading"><div><div class="eyebrow">MELTECH ELECTRICALS & REFRIGERATION</div><h1>Create a document</h1><p>Prepare a professional invoice or quotation in minutes.</p></div><div class="actions"><button class="btn" id="newBtn">＋ New</button><button class="btn primary" id="printBtn">⇩ &nbsp;Download PDF</button></div></div><div class="content"><section class="panel formpanel"><div class="paneltitle"><h2>Document details</h2><span class="step">Draft · Auto-saved</span></div><div class="type-switch"><button id="invoiceTab" class="selected">Invoice</button><button id="quoteTab">Quotation</button></div><div class="section-label">Client information</div><div class="fields"><div class="field wide"><label>Client name</label><input id="client" value="WILLOW HOTEL" placeholder="e.g. Melvin Wafula"></div><div class="field"><label>Client PIN</label><input id="pin" value="P052279714G" placeholder="e.g. P012345678A"></div><div class="field"><label>Phone number</label><input id="phone" value="0748961520" placeholder="e.g. 07xx xxx xxx"></div></div><div class="section-label">Document date and time</div><div class="fields"><div class="field"><label>Date</label><input id="date" type="date"></div><div class="field"><label>Time</label><input id="time" type="time"></div></div><div class="section-label">Service details</div><div class="fields"><div class="field wide"><label>Service description</label><textarea id="service" placeholder="Describe the service provided, e.g. Commercial cooker servicing"></textarea></div></div><div class="section-label">Line items</div><div class="items-head"><span>Description</span><span>Qty</span><span>Unit</span><span>Price (KES)</span><span></span></div><div id="items"></div><button class="addrow" id="addItem">＋ Add line item</button><div class="section-label">Notes for your client</div><div class="fields"><div class="field wide"><label>Scope of work</label><textarea id="scope">Supply of materials and repair services for commercial kitchen equipment including inspection, cleaning, servicing, adjustment and operational testing to ensure optimum performance.</textarea></div><div class="field wide"><label>Terms and conditions</label><textarea id="terms">Payment due upon receipt of invoice.\nAll replaced parts are subject to standard warranty terms.\nWork carried out is for the items listed above only.\nThank you for choosing MELTECH Electricals & Refrigeration Services.</textarea></div></div><div class="section-label">VAT</div><div class="fields"><div class="field wide" style="display:flex;align-items:center;gap:9px"><input id="vatEnabled" type="checkbox" style="width:16px;height:16px;accent-color:#d69b18"><label for="vatEnabled" style="margin:0">Apply VAT to this document</label></div><div class="field" id="vatRateField" style="display:none"><label>VAT rate (%)</label><input id="vatRate" type="number" min="0" max="100" step="0.01" value="16"></div></div><div class="section-label">eTIMS receipt details</div><div class="fields"><div class="field"><label>eTIMS receipt / invoice number</label><input id="etimsNo" placeholder="e.g.  KRAXXXXXXXXX"></div><div class="field"><label>Control unit / device serial</label><input id="etimsControl" placeholder="Control unit ID"></div><div class="field"><label>eTIMS verification code</label><input id="etimsCode" placeholder="Verification code"></div><div class="field"><label>QR code image</label><input id="qrFile" type="file" accept="image/*"></div><div class="field wide"><label>QR verification link or encoded data (optional)</label><input id="qrText" placeholder="Paste the eTIMS verification URL or code"></div></div></section><section class="panel previewpanel"><div class="preview-toolbar"><span>DOCUMENT PREVIEW</span><span class="live">● Live preview</span></div><article class="paper" id="paper"><img class="stationery" src="meltech-stationery.png" alt="Meltech original invoice layout with the exact header, icons, watermark, signature and service footer"><header class="dochead"><img src="meltech-header.jpg" alt="Meltech Electricals and Refrigeration Services, Eldoret, Kenya, 0707494395"></header><div class="docbody"><h1 class="doctitle" id="docTitle">INVOICE</h1><div class="details"><div class="details-col"><div class="detail"><b>▣ &nbsp; Number:</b><span id="docNo"></span></div><div class="detail"><b>▦ &nbsp; Date:</b><span id="docDate"></span></div><div class="detail"><b>◷ &nbsp; Time:</b><span id="docTime"></span></div></div><div class="details-col"><div class="detail"><b>● &nbsp; Client:</b><span id="docClient"></span></div><div class="detail"><b>CLIENT PIN:</b><span id="docPin"></span></div><div class="detail"><b>☎ &nbsp; Phone:</b><span id="docPhone"></span></div><div class="detail"><b>▣ &nbsp; Service:</b><span id="docService"></span></div></div></div><table class="table"><thead><tr><th>NO.</th><th>DESCRIPTION</th><th>QTY</th><th>UNIT</th><th>UNIT PRICE (KES)</th><th>TOTAL (KES)</th></tr></thead><tbody id="previewItems"></tbody></table><div class="totals"><div class="totalrow"><span>SUBTOTAL</span><span>KES</span><span id="subtotal">0.00</span></div><div class="totalrow" id="vatRow" style="display:none"><span id="vatLabel">VAT (16%)</span><span>KES</span><span id="vatAmount">0.00</span></div><div class="totalrow"><span id="netLabel">NET AMOUNT DUE</span><span>KES</span><span id="total">0.00</span></div></div><div class="etims-preview" id="etimsPreview" style="display:none;border:1px solid #dfaa32;border-radius:6px;padding:8px;margin-top:12px;align-items:center;gap:12px;font-size:9px"><img id="qrPreview" alt="eTIMS QR code" style="width:64px;height:64px;object-fit:contain;display:none"><div><b>eTIMS RECEIPT DETAILS</b><div id="etimsOut" style="line-height:1.6;margin-top:4px"></div><div id="qrOut" style="word-break:break-all"></div></div></div><div class="notes"><section class="note"><h3>◉ &nbsp; SCOPE OF WORK</h3><p id="previewScope"></p></section><section class="note"><h3>▤ &nbsp; TERMS & CONDITIONS</h3><ol class="terms" id="previewTerms"></ol></section></div><div class="signature"><div>Prepared By:<strong>MELVIN SIMIYU WAFULA</strong><i>For: MELTECH ELECTRICALS & REFRIGERATION SERVICES</i><img class="signature-img" src="meltech-signature.png" alt="Melvin Simiyu Wafula signature"><div>Signature</div></div><div><strong id="signDate"></strong><div style="margin-top:14px">________________<br>Date</div></div></div></div><footer class="docfoot"><img src="meltech-footer.png" alt="Meltech quality, safety and reliability; electrical, refrigeration, maintenance and consultancy services"></footer></article></section></div><section class="history" id="history"><h2>Recent documents</h2><div class="history-list" id="historyList"></div></section><section class="accounting" id="accounting"><div class="account-heading"><div><h2>Sales &amp; payment reports</h2><p>Sales use document dates; collections use payment dates. This management report is not printed on client documents.</p></div><div class="acct-tools"><label>Report period <select id="accountPeriod"><option value="all">All time</option><option value="month">This month</option><option value="previousMonth">Last month</option><option value="year">This year</option></select></label><button class="btn" id="exportReport">Download CSV</button></div></div><div class="account-stats" id="accountStats"></div><div class="report-note">Older payment records without a payment date are included in All time totals only.</div><div class="account-list" id="accountList"></div></section><section id="adminPanel" class="hidden" style="margin:24px 0;padding:18px;background:white;border:1px solid #e9e6df;border-radius:10px"><h2>Staff and user accounts</h2><p>Admin only. Invited accounts receive an email to set their password.</p><form id="inviteForm"><input id="inviteName" placeholder="Full name" required><input id="inviteEmail" type="email" placeholder="Email" required><select id="inviteRole"><option value="staff">Staff</option><option value="user">User</option><option value="admin">Admin</option></select><button class="btn primary">Invite</button></form><div id="userList"></div><p id="adminMessage"></p></section></main></div></div><div class="toast" id="toast"></div><dialog class="doc-dialog" id="docDialog"><div class="dialog-head"><h2 id="dialogTitle">Document</h2><button class="btn" id="closeDialog">Close</button></div><div class="dialog-body" id="dialogBody"></div></dialog>
<script>
const $=id=>document.getElementById(id), money=n=>Number(n||0).toLocaleString('en-KE',{minimumFractionDigits:2,maximumFractionDigits:2});let kind='INVOICE',activeNo='',activeDocId=null,items=[{desc:'Commercial cooker servicing',qty:1,unit:'Set',price:4000}],docs=JSON.parse(localStorage.getItem('meltechDocs')||'[]');const today=new Date();$('date').value=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);$('time').value=localTime();
async function api(path,opts={}){const r=await fetch(path,{...opts,credentials:"same-origin",headers:{"Content-Type":"application/json",...(opts.headers||{})}});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||"Request failed");return d}
function unlock(user){$("authScreen").style.display="none";$("appRoot").classList.remove("hidden");$("signedInAs").textContent=user.fullName+" · "+user.role;window.meltechUser=user;$("adminPanel").classList.toggle("hidden",user.role!=="admin");$("adminNav").classList.toggle("hidden",user.role!=="admin");if(user.role==="admin")loadUsers()}
function showLogin(message){$("authScreen").style.display="grid";$("appRoot").classList.add("hidden");if(message)$("authMessage").textContent=message}
async function loadUsers(){try{const d=await api("/api/admin/users");$("userList").innerHTML=d.users.map(u=>'<div style="padding:9px;border-top:1px solid #eee">'+escapeHtml(u.fullName)+' · '+escapeHtml(u.email)+' · '+escapeHtml(u.role)+' · '+escapeHtml(u.status)+' <button data-disable="'+u.id+'">Disable</button></div>').join("");$("userList").querySelectorAll("[data-disable]").forEach(b=>b.onclick=async()=>{await api("/api/admin/users",{method:"DELETE",body:JSON.stringify({id:b.dataset.disable})});loadUsers()})}catch(e){$("adminMessage").textContent=e.message}}
$("resetBtn").onclick=async()=>{const q=new URLSearchParams(location.search);try{await api("/api/auth/reset-password",{method:"POST",body:JSON.stringify({token:q.get("reset"),email:q.get("email"),password:$("newPassword").value})});history.replaceState({},document.title,location.pathname);$("resetBox").style.display="none";$("authMessage").textContent="Password reset. You can sign in now."}catch(e){$("authMessage").textContent=e.message}};if(new URLSearchParams(location.search).has("reset"))$("resetBox").style.display="block";$("loginBtn").onclick=async()=>{try{const d=await api("/api/auth/login",{method:"POST",body:JSON.stringify({email:$("loginEmail").value,password:$("loginPassword").value})});unlock(d.user)}catch(e){$("authMessage").textContent=e.message}};
$("forgotBtn").onclick=async()=>{const email=$("loginEmail").value||prompt("Enter your account email");if(!email)return;try{await api("/api/auth/forgot-password",{method:"POST",body:JSON.stringify({email})});$("authMessage").textContent="If the account exists, a reset email has been sent."}catch(e){$("authMessage").textContent=e.message}};
$("logoutBtn").onclick=async()=>{try{await api("/api/auth/logout",{method:"POST"})}finally{showLogin("You have signed out.")}};
$("localBtn").onclick=()=>{if(location.protocol==="file:"||location.hostname==="localhost"){unlock({fullName:"Local preview",role:"local"})}else $("authMessage").textContent="Local preview is only available on this device."};
$("inviteForm").onsubmit=async e=>{e.preventDefault();try{await api("/api/admin/users",{method:"POST",body:JSON.stringify({fullName:$("inviteName").value,email:$("inviteEmail").value,role:$("inviteRole").value})});$("inviteForm").reset();$("adminMessage").textContent="Invitation email sent.";loadUsers()}catch(err){$("adminMessage").textContent=err.message}};
(async()=>{if(location.protocol==="file:"||location.hostname==="localhost"){$("localBtn").style.display="inline-block";return}try{const d=await api("/api/auth/me");if(d.user)unlock(d.user);else showLogin()}catch(e){showLogin("Account service unavailable: "+e.message)}})();function sequenceMax(k,year){const prefix=k==='INVOICE'?'INV':'QUO',key=`${k}_${year}`,seq=JSON.parse(localStorage.getItem('meltechSequences')||'{}');let max=Number(seq[key]||0);for(const d of docs){const m=String(d.no||'').match(new RegExp(`^MEL/${prefix}/(\\d{4})/${year}$`));if(m)max=Math.max(max,Number(m[1]))}return max}function peekNumber(k){const year=(($('date').value||'').slice(0,4))||String(new Date().getFullYear()),prefix=k==='INVOICE'?'INV':'QUO';return `MEL/${prefix}/${String(sequenceMax(k,year)+1).padStart(4,'0')}/${year}`}function allocateNumber(k){const no=peekNumber(k),m=no.match(/^MEL\/(INV|QUO)\/(\d{4})\/(\d{4})$/),seq=JSON.parse(localStorage.getItem('meltechSequences')||'{}');if(m){seq[`${k}_${m[3]}`]=Math.max(Number(seq[`${k}_${m[3]}`]||0),Number(m[2]));localStorage.setItem('meltechSequences',JSON.stringify(seq))}return no}function commitNumber(k,no){const m=String(no||'').match(/^MEL\/(INV|QUO)\/(\d{4})\/(\d{4})$/);if(!m)return;const seq=JSON.parse(localStorage.getItem('meltechSequences')||'{}'),key=`${k}_${m[3]}`;seq[key]=Math.max(Number(seq[key]||0),Number(m[2]));localStorage.setItem('meltechSequences',JSON.stringify(seq))}function docNum(){return activeNo||peekNumber(kind)}function localTime(){const d=new Date();return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`}
function render(){const host=$('items');host.innerHTML='';items.forEach((it,i)=>{let row=document.createElement('div');row.className='itemrow';row.innerHTML=`<input class="desc" aria-label="Description" value="${escapeHtml(it.desc)}" data-i="${i}" data-k="desc"><input aria-label="Quantity" type="number" min="0" step="1" value="${it.qty}" data-i="${i}" data-k="qty"><input aria-label="Unit" value="${escapeHtml(it.unit)}" data-i="${i}" data-k="unit"><input aria-label="Unit price" type="number" min="0" step="0.01" value="${it.price}" data-i="${i}" data-k="price"><button class="remove" data-remove="${i}" aria-label="Remove item">×</button>`;host.append(row)});host.querySelectorAll('input').forEach(e=>e.oninput=()=>{items[+e.dataset.i][e.dataset.k]=e.dataset.k==='desc'||e.dataset.k==='unit'?e.value:Number(e.value);update()});host.querySelectorAll('[data-remove]').forEach(e=>e.onclick=()=>{items.splice(+e.dataset.remove,1);render()});update()}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function update(){const fields=['client','pin','phone','service','date','time','scope','terms','etimsNo','etimsControl','etimsCode','qrText','vatRate'];let d=Object.fromEntries(fields.map(k=>[k,$(k).value]));d.vatEnabled=$('vatEnabled').checked;$('docTitle').textContent=kind;$('docNo').textContent=docNum();$('docClient').textContent=d.client||'—';$('docPin').textContent=d.pin||'—';$('docPhone').textContent=d.phone||'—';$('docService').textContent=d.service||'—';let dt=d.date?new Date(d.date+'T00:00:00'):new Date();$('docDate').textContent=dt.toLocaleDateString('en-GB')+'  '+(d.time||localTime());$('docTime').textContent='';$('paper').classList.toggle('has-vat',!!d.vatEnabled);$('paper').classList.toggle('has-etims',!!(d.etimsNo||d.etimsControl||d.etimsCode||d.qrText||window.qrData));$('signDate').textContent=dt.toLocaleDateString('en-GB');$('previewScope').textContent=d.scope;let terms=d.terms.split('\n').filter(Boolean);$('previewTerms').innerHTML=terms.map(x=>`<li>${escapeHtml(x)}</li>`).join('');$('previewItems').innerHTML=items.length?items.map((it,i)=>`<tr><td>${i+1}</td><td>${escapeHtml(it.desc)}</td><td>${it.qty||0}</td><td>${escapeHtml(it.unit)}</td><td>${money(it.price)}</td><td>${money((+it.qty||0)*(+it.price||0))}</td></tr>`).join(''):`<tr><td colspan="6" style="height:45px;text-align:center">Add a line item</td></tr>`;let subtotal=items.reduce((a,x)=>a+(+x.qty||0)*(+x.price||0),0),rate=Math.max(0,Math.min(100,+d.vatRate||0)),vat=d.vatEnabled?subtotal*rate/100:0,total=subtotal+vat;$('subtotal').textContent=money(subtotal);$('vatRow').style.display=d.vatEnabled?'grid':'none';$('vatRateField').style.display=d.vatEnabled?'block':'none';$('vatLabel').textContent=`VAT (${rate}%)`;$('vatAmount').textContent=money(vat);$('total').textContent=money(total);$('netLabel').textContent=kind==='INVOICE'?'NET AMOUNT DUE':'QUOTATION TOTAL';const hasEtims=!!(d.etimsNo||d.etimsControl||d.etimsCode||d.qrText||window.qrData);$('etimsPreview').style.display=hasEtims?'flex':'none';$('etimsOut').textContent=[d.etimsNo&&'Receipt: '+d.etimsNo,d.etimsControl&&'Control unit: '+d.etimsControl,d.etimsCode&&'Verification: '+d.etimsCode].filter(Boolean).join(' · ');$('qrOut').textContent=d.qrText||'';$('qrPreview').style.display=window.qrData?'block':'none';if(window.qrData)$('qrPreview').src=window.qrData;localStorage.setItem('meltechDraft',JSON.stringify({kind,items,d,qrData:window.qrData||'',docNo:activeNo}));}
document.querySelectorAll('#client,#pin,#phone,#date,#time,#service,#scope,#terms,#etimsNo,#etimsControl,#etimsCode,#qrText,#vatRate').forEach(e=>e.oninput=update);$('vatEnabled').onchange=update;$('addItem').onclick=()=>{if(items.length>=5){notify('This invoice layout supports up to five line items');return}items.push({desc:'',qty:1,unit:'Item',price:0});render()};$('invoiceTab').onclick=()=>setKind('INVOICE');$('quoteTab').onclick=()=>setKind('QUOTATION');function setKind(k){if(kind!==k){if(activeDocId){notify('Start a new document before changing its type');return}if(activeNo){notify('Save this numbered draft before changing its type');return}kind=k}$('invoiceTab').classList.toggle('selected',k==='INVOICE');$('quoteTab').classList.toggle('selected',k==='QUOTATION');update()}$('printBtn').onclick=()=>window.print();$('newBtn').onclick=()=>{if(!activeDocId){notify('Create this document first: save it before starting another so its number is not skipped');return}if(!confirm('Start a new document?'))return;items=[{desc:'',qty:1,unit:'Item',price:0}];activeDocId=null;activeNo='';save.textContent='Create document';$('time').value=localTime();['client','pin','phone','service','etimsNo','etimsControl','etimsCode','qrText','scope'].forEach(k=>$(k).value='');$('vatEnabled').checked=false;window.qrData='';$('scope').value='';$('terms').value='Payment due upon receipt of invoice.\nAll replaced parts are subject to standard warranty terms.\nThank you for choosing MELTECH Electricals & Refrigeration Services.';render();notify('New document ready')};
function saveDoc(){let existing=docs.find(d=>d.id===activeDocId);if(!existing){$('time').value=localTime();activeNo=activeNo||allocateNumber(kind);commitNumber(kind,activeNo);update()}else activeNo=existing.no;let data=JSON.parse(localStorage.getItem('meltechDraft')||'{}'),subtotal=items.reduce((a,x)=>a+(+x.qty||0)*(+x.price||0),0),total=subtotal+(data.d?.vatEnabled?subtotal*(+data.d?.vatRate||0)/100:0),record={...(existing||{}),id:existing?.id||Date.now(),kind,no:activeNo,client:data.d?.client||'New client',date:data.d?.date,total,createdAt:existing?.createdAt||new Date().toISOString(),snapshot:{kind,items:JSON.parse(JSON.stringify(items)),d:data.d||{},qrData:window.qrData||'',docNo:activeNo}};if(!existing){record.paymentStatus='UNPAID';record.amountPaid=0;docs.unshift(record)}else Object.assign(existing,record);record.amountPaid=Math.min(Number(record.amountPaid||0),Number(total)||0);record.paymentStatus=record.amountPaid>=Number(total)&&Number(total)>0?'PAID':record.amountPaid>0?'PARTIALLY PAID':'UNPAID';activeDocId=record.id;save.textContent='Save changes';localStorage.setItem('meltechDocs',JSON.stringify(docs));renderHistory();notify('Document saved')}
function periodMatches(value,period){if(period==='all')return true;if(!value)return false;const d=new Date(String(value).length===10?String(value)+'T00:00:00':value);if(Number.isNaN(d.getTime()))return false;const n=new Date();if(period==='month')return d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth();if(period==='previousMonth'){const x=new Date(n.getFullYear(),n.getMonth()-1,1);return d.getFullYear()===x.getFullYear()&&d.getMonth()===x.getMonth()}if(period==='year')return d.getFullYear()===n.getFullYear();return true}function paymentsInPeriod(doc,period){if(!Array.isArray(doc.payments))return period==='all'?Number(doc.amountPaid)||0:0;return doc.payments.reduce((s,p)=>s+((p.legacy&&!p.date?period==='all':periodMatches(p.date,period))?(Number(p.amount)||0):0),0)}function reportDocs(period){return docs.filter(d=>periodMatches(d.date,period)||paymentsInPeriod(d,period)>0)}function renderAccounting(){const period=$('accountPeriod')?.value||'all',invoices=docs.filter(d=>d.kind==='INVOICE'),salesDocs=invoices.filter(d=>periodMatches(d.date,period)),quotes=docs.filter(d=>d.kind==='QUOTATION'&&!d.convertedTo&&periodMatches(d.date,period)),sales=salesDocs.reduce((a,d)=>a+(Number(d.total)||0),0),received=invoices.reduce((a,d)=>a+paymentsInPeriod(d,period),0),outstanding=salesDocs.reduce((a,d)=>a+Math.max(0,(Number(d.total)||0)-(Number(d.amountPaid)||0)),0),quoteValue=quotes.reduce((a,d)=>a+(Number(d.total)||0),0);$('accountStats').innerHTML='<div class="account-stat"><small>Invoice sales</small><strong>KES '+money(sales)+'</strong></div><div class="account-stat"><small>Payments received</small><strong>KES '+money(received)+'</strong></div><div class="account-stat"><small>Open balance on period sales</small><strong>KES '+money(outstanding)+'</strong></div><div class="account-stat"><small>Open quotation pipeline</small><strong>KES '+money(quoteValue)+'</strong></div>';const shown=reportDocs(period);if(!shown.length){$('accountList').innerHTML='<div class="acct-none">No documents or payment activity for this period.</div>';return}$('accountList').innerHTML=shown.map(d=>{const ls=d.snapshot?.items||[],cash=Math.min(Number(d.amountPaid)||0,Number(d.total)||0),base=ls.reduce((a,x)=>a+(+x.qty||0)*(+x.price||0),0),factor=base>0?(Number(d.total)||base)/base:1;let remaining=cash;const paidRows=[],dueRows=[];ls.forEach(x=>{const line=(+x.qty||0)*(+x.price||0)*factor,got=Math.min(line,remaining),due=Math.max(0,line-got);remaining=Math.max(0,remaining-line);const row='<tr><td>'+escapeHtml(x.desc||'')+'</td><td>KES '+money(got)+'</td><td>KES '+money(due)+'</td></tr>';(due<=0?paidRows:dueRows).push(row)});return '<details class="account-doc"><summary><span class="acct-name">'+escapeHtml(d.client||'New client')+'<small>'+escapeHtml(d.no||'')+' · '+(d.kind==='INVOICE'?'Invoice':'Quotation')+' · '+escapeHtml(d.paymentStatus||'UNPAID')+'</small></span><span class="acct-val">Document total<b>KES '+money(d.total)+'</b></span><span class="acct-val">Received<b>KES '+money(cash)+'</b></span><span class="acct-val">Balance<b>KES '+money(Math.max(0,(Number(d.total)||0)-cash))+'</b></span></summary><div class="acct-groups"><section class="acct-group"><h3>Paid items</h3>'+(paidRows.length?'<table class="acct-table"><thead><tr><th>Item</th><th>Paid</th><th>Unpaid</th></tr></thead><tbody>'+paidRows.join('')+'</tbody></table>':'<div class="acct-none">No fully paid items yet.</div>')+'</section><section class="acct-group"><h3>Unpaid / partially paid items</h3>'+(dueRows.length?'<table class="acct-table"><thead><tr><th>Item</th><th>Paid</th><th>Unpaid</th></tr></thead><tbody>'+dueRows.join('')+'</tbody></table>':'<div class="acct-none">No unpaid item balances.</div>')+'</section></div></details>'}).join('')}function exportReport(){const period=$('accountPeriod').value,rows=[['Document number','Type','Client','Document date','Document total KES','Payments in selected period KES','Total paid KES','Balance KES','Status']];for(const d of reportDocs(period))rows.push([d.no||'',d.kind||'',d.client||'',d.date||'',Number(d.total)||0,paymentsInPeriod(d,period),Number(d.amountPaid)||0,Math.max(0,(Number(d.total)||0)-(Number(d.amountPaid)||0)),d.paymentStatus||'UNPAID']);const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n'),url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='meltech-sales-payments-'+period+'-'+new Date().toISOString().slice(0,10)+'.csv';a.click();URL.revokeObjectURL(url)}
function renderHistory(){let h=$('historyList');if(!docs.length){h.innerHTML='<div class="empty">Your saved invoices and quotations will appear here.</div>';renderAccounting();return}h.innerHTML=docs.map(d=>{let st=d.paymentStatus||'UNPAID',cl=st==='PAID'?'paid':st==='PARTIALLY PAID'?'partial':'';return `<div class="history-item"><div class="hist-left"><div class="docbadge">${d.kind==='INVOICE'?'INV':'QUO'}</div><div><div class="hist-title">${escapeHtml(d.client||'New client')}</div><div class="hist-sub">${escapeHtml(d.no||'')} · ${escapeHtml(d.date||'')}</div><span class="status-pill ${cl}">${st}${st==='PARTIALLY PAID'?` · KES ${money(d.amountPaid||0)} paid`:''}</span></div></div><div style="text-align:right"><div class="hist-total">KES ${money(d.total)}</div><div class="history-actions"><button class="btn" data-action="view" data-id="${d.id}">View</button><button class="btn" data-action="edit" data-id="${d.id}">Edit</button><button class="btn" data-action="paid" data-id="${d.id}">Mark paid</button>${d.kind==='QUOTATION'?(d.convertedTo?`<span class="status-pill paid">Converted · ${escapeHtml(typeof d.convertedTo==='string'?d.convertedTo:d.convertedTo.no)}</span>`:`<button class="btn" data-action="convert" data-id="${d.id}">Convert to invoice</button>`):''}<button class="btn" data-action="partial" data-id="${d.id}">Partial</button><button class="btn" data-action="delete" data-id="${d.id}">Delete</button></div></div></div>`}).join('');renderAccounting()}
function viewDoc(d){const snap=d.snapshot||{},ls=snap.items||[],dt=snap.d||{},paid=Number(d.amountPaid||0),status=d.paymentStatus||'UNPAID';$('dialogTitle').textContent=`${d.kind==='QUOTATION'?'Quotation':'Invoice'} ${d.no||''}`;$('dialogBody').innerHTML=`<div class="view-grid"><div class="view-cell"><small>CLIENT</small>${escapeHtml(d.client||'—')}</div><div class="view-cell"><small>DATE</small>${escapeHtml(d.date||'—')}</div><div class="view-cell"><small>STATUS</small>${escapeHtml(status)}</div><div class="view-cell"><small>PAYMENT</small>KES ${money(paid)} paid · KES ${money(Math.max(0,d.total-paid))} balance</div></div>${ls.length?`<table class="view-lines"><thead><tr><th>Description</th><th>Qty</th><th>Unit</th><th>Price</th><th>Total</th></tr></thead><tbody>${ls.map(x=>`<tr><td>${escapeHtml(x.desc||'')}</td><td>${Number(x.qty)||0}</td><td>${escapeHtml(x.unit||'')}</td><td>KES ${money(x.price)}</td><td>KES ${money((+x.qty||0)*(+x.price||0))}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">This older saved record has no item details available.</div>'}<div class="view-meta"><b>Document total:</b> KES ${money(d.total)}${dt.vatEnabled?` · VAT (${escapeHtml(dt.vatRate||'0')}%): KES ${money((d.total-(ls.reduce((a,x)=>a+(+x.qty||0)*(+x.price||0),0))))}`:''}<br><b>Client PIN:</b> ${escapeHtml(dt.pin||'—')} · <b>Phone:</b> ${escapeHtml(dt.phone||'—')}<br><b>Service:</b> ${escapeHtml(dt.service||'—')}${dt.etimsNo?`<br><b>eTIMS receipt:</b> ${escapeHtml(dt.etimsNo)}`:''}${dt.etimsControl?` · <b>Control unit:</b> ${escapeHtml(dt.etimsControl)}`:''}${dt.etimsCode?` · <b>Verification:</b> ${escapeHtml(dt.etimsCode)}`:''}${dt.qrText?`<br><b>QR verification:</b> ${escapeHtml(dt.qrText)}`:''}${dt.scope?`<br><b>Scope:</b> ${escapeHtml(dt.scope)}`:''}${dt.terms?`<br><b>Terms:</b> ${escapeHtml(dt.terms).replace(/\n/g,' · ')}`:''}</div>${snap.qrData?`<img src="${snap.qrData}" alt="eTIMS QR code" style="width:92px;height:92px;object-fit:contain">`:''}<button class="btn primary" id="dialogEdit" data-id="${d.id}">Edit this document</button>${d.kind==='QUOTATION'&&!d.convertedTo?`<button class="btn" id="dialogConvert">Convert to invoice</button>`:d.convertedTo?`<span class="status-pill paid">Converted · ${escapeHtml(typeof d.convertedTo==='string'?d.convertedTo:d.convertedTo.no)}</span>`:''}`;$('docDialog').showModal();$('dialogEdit').onclick=()=>{$('docDialog').close();loadDoc(d.id)};if($('dialogConvert'))$('dialogConvert').onclick=()=>{$('docDialog').close();convertQuote(d.id)}}
function loadDoc(id){const d=docs.find(x=>String(x.id)===String(id));if(!d?.snapshot){notify('This older record has no editable detail saved');return}let s=d.snapshot;kind=s.kind||d.kind;activeNo=s.docNo||d.no;activeDocId=d.id;save.textContent='Save changes';commitNumber(kind,activeNo);items=JSON.parse(JSON.stringify(s.items||[]));window.qrData=s.qrData||'';Object.entries(s.d||{}).forEach(([k,v])=>{if($(k)){if(k==='vatEnabled')$(k).checked=!!v;else $(k).value=v}});$('invoiceTab').classList.toggle('selected',kind==='INVOICE');$('quoteTab').classList.toggle('selected',kind==='QUOTATION');render();window.scrollTo({top:0,behavior:'smooth'});notify('Document loaded')}
function convertQuote(id){const q=docs.find(x=>String(x.id)===String(id));if(!q||q.kind!=='QUOTATION'||!q.snapshot){notify('This quotation does not have saved details to convert');return}if(q.convertedTo){notify('This quotation has already been converted');return}if(activeDocId){const current=docs.find(x=>x.id===activeDocId),draft=JSON.parse(localStorage.getItem('meltechDraft')||'{}');if(current&&((JSON.stringify(draft.items||[])!==JSON.stringify(current.snapshot?.items||[]))||(JSON.stringify(draft.d||{})!==JSON.stringify(current.snapshot?.d||{})))){notify('Save current edits before converting the quotation');return}}else if(activeNo){notify('Create the current numbered document before converting');return}const snap=q.snapshot;kind='INVOICE';activeNo='';activeDocId=null;items=JSON.parse(JSON.stringify(snap.items||[]));window.qrData='';Object.entries(snap.d||{}).forEach(([k,v])=>{if($(k)){if(k==='vatEnabled')$(k).checked=!!v;else $(k).value=v}});['etimsNo','etimsControl','etimsCode','qrText'].forEach(k=>$(k).value='');$('date').value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);$('time').value=localTime();$('qrFile').value='';$('invoiceTab').classList.add('selected');$('quoteTab').classList.remove('selected');save.textContent='Create document';render();saveDoc();q.convertedTo=activeNo;localStorage.setItem('meltechDocs',JSON.stringify(docs));renderHistory();window.scrollTo({top:0,behavior:'smooth'});notify(`Quotation converted to invoice ${activeNo}`)}
function markPaid(id,partial){const d=docs.find(x=>String(x.id)===String(id));if(!d)return;const total=Number(d.total)||0,paid=Number(d.amountPaid)||0,balance=Math.max(0,total-paid);let amount=balance;if(partial){const raw=prompt('Enter amount received in this payment (balance KES '+money(balance)+'):','');if(raw===null)return;amount=Number(raw);if(!Number.isFinite(amount)||amount<=0||amount>balance){notify('Enter an amount greater than zero and no more than the balance');return}}if(!Array.isArray(d.payments)){d.payments=[];if(paid>0)d.payments.push({amount:paid,date:'',legacy:true})}if(amount>0)d.payments.push({amount,date:new Date().toISOString()});d.amountPaid=Math.min(total,paid+amount);d.paymentStatus=d.amountPaid>=total?'PAID':'PARTIALLY PAID';localStorage.setItem('meltechDocs',JSON.stringify(docs));renderHistory();notify(d.amountPaid>=total?'Payment recorded; invoice is paid':'Partial payment recorded')}
$('historyList').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b)return;const d=docs.find(x=>String(x.id)===b.dataset.id);if(!d)return;switch(b.dataset.action){case'view':viewDoc(d);break;case'edit':loadDoc(d.id);break;case'paid':markPaid(d.id,false);break;case'partial':markPaid(d.id,true);break;case'convert':convertQuote(d.id);break;case'delete':if(confirm(`Delete ${d.no||'this document'}?`)){docs=docs.filter(x=>x.id!==d.id);localStorage.setItem('meltechDocs',JSON.stringify(docs));renderHistory();notify('Document deleted')}}});$('closeDialog').onclick=()=>$('docDialog').close();
function notify(msg){let t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2100)}$('accountPeriod').onchange=renderAccounting;$('exportReport').onclick=exportReport;const save=document.createElement('button');save.className='btn';save.textContent='Create document';save.onclick=saveDoc;document.querySelector('.actions').insertBefore(save,$('printBtn'));let draft=JSON.parse(localStorage.getItem('meltechDraft')||'null');if(draft){window.qrData=draft.qrData||'';kind=draft.kind||kind;activeNo=draft.docNo||'';items=draft.items||items;Object.entries(draft.d||{}).forEach(([k,v])=>{if($(k)){if(k==='vatEnabled')$(k).checked=!!v;else $(k).value=v}});$('invoiceTab').classList.toggle('selected',kind==='INVOICE');$('quoteTab').classList.toggle('selected',kind==='QUOTATION');activeDocId=docs.find(x=>x.no===activeNo)?.id||null}$('qrFile').onchange=e=>{const f=e.target.files[0];if(!f)return;const reader=new FileReader();reader.onload=()=>{window.qrData=reader.result;update()};reader.readAsDataURL(f)};render();renderHistory();
</script></body></html>
